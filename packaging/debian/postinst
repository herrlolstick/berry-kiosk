#!/bin/sh
# berry-kiosk: system user, data directory and services
set -e

STATE=/var/lib/berry-kiosk
USER=berry-kiosk

# Without systemd-tmpfiles (containers): create only what does not exist yet.
# Existing paths are never touched, so a symlink the service user planted in
# its own directory cannot redirect root's chown/chmod/copy elsewhere.
create_dir() {
    if [ ! -e "$1" ] && [ ! -L "$1" ]; then
        mkdir -m "$2" "$1"
        chown -h "$USER:$USER" "$1"
    fi
}

if [ "$1" = "configure" ]; then
    if ! getent passwd "$USER" >/dev/null; then
        useradd --system --user-group --home-dir "$STATE" --no-create-home \
            --shell /usr/sbin/nologin --comment "berry-kiosk" "$USER"
    fi

    if command -v systemd-tmpfiles >/dev/null; then
        systemd-tmpfiles --create berry-kiosk.conf
    else
        create_dir "$STATE" 0750
        create_dir "$STATE/media" 2775
        create_dir "$STATE/state" 0700
        if [ ! -e "$STATE/config.json" ] && [ ! -L "$STATE/config.json" ]; then
            cp /usr/share/berry-kiosk/config.example.json "$STATE/config.json"
            chown -h "$USER:$USER" "$STATE/config.json"
            chmod 0640 "$STATE/config.json"
        fi
    fi

    if command -v udevadm >/dev/null; then
        udevadm control --reload-rules || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable berry-kiosk-admin.service berry-kiosk-display.service >/dev/null
        systemctl restart berry-kiosk-admin.service berry-kiosk-display.service || true
    fi

    if [ ! -e "$STATE/state/auth.json" ]; then
        echo "berry-kiosk: Passwort für die Verwaltung setzen mit"
        echo "  sudo -u $USER berry-kiosk-admin --config $STATE/config.json --set-password"
    fi
fi

exit 0
